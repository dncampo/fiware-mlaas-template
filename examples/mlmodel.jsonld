  "name": {
    "type": "Property",
    "value": "Water Potability (teaching example)"
  },
  "description": {
    "type": "Property",
    "value": "Binary classifier for tabular water-quality features; not a safety assessment"
  },
  "algorithm": {
    "type": "Property",
