      "WaterQualityObserved"
    ]
  },
  "outputAttributes": {
    "type": "Property",
    "value": [
      "predictedValue",
      "predictionScore"
    ]
  },
  "outputDataTypes": {
    "type": "Property",
    "value": [
      "integer",
      "number"
    ]
  },
  "servingEndpoint": {
    "type": "Property",
    "value": "http://ml-serving:5000/invocations"
  },
  "artifactURI": {
    "type": "Property",
    "value": "./artifacts/water-potability/v1"
  },
  "@context": {
    "@vocab": "https://example.org/fiware-mlaas/terms/",
    "id": "@id",
    "type": "@type",
